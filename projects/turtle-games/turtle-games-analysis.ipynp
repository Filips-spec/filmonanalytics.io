   "source": [
    "#description of the clusters (k=5)\n",
    "group_summary = df3.groupby('cluster')[['remuneration', 'spending_score']].mean().round(2)\n",
    "group_sizes = df3['cluster'].value_counts().sort_index()\n",
    "group_summary['Count'] = group_sizes\n",
    "group_summary\n"
   ]
