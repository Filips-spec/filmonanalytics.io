    "#import seaborn library\n",
    "import seaborn as sns\n",
    "\n",
    "#plot remuneration vs spending_score to determine any correlation\n",
    "sns.scatterplot(x='remuneration',\n",
    "                y='spending_score',\n",
    "                data=df3,\n",
    "                s=50)\n",
    "\n",
    "#create a pairplot with seaborn\n",
    "sns.pairplot(df3, vars=['remuneration', 'spending_score'], \n",
    "             height=3,palette='Set2')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 434,
   "id": "7d801926-161f-450c-a46d-b149a468a146",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#elbow method\n",
    "#import library\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "#select the features\n",
    "X = df3[['remuneration', 'spending_score']]\n",
    "\n",
    "#scale the features\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "#calculate WCSS for k = 1 to 10\n",
    "ss = []\n",
    "K = range(1, 11)\n",
    "\n",
    "for k in K:\n",
    "    kmeans = KMeans(n_clusters=k, init='k-means++', random_state=42)\n",
    "    kmeans.fit(X_scaled)\n",
    "    ss.append(kmeans.inertia_)\n",
    "\n",
    "#plot the elbow curve\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(K, ss, 'bo-', markersize=8)\n",
    "plt.title('Elbow Method')\n",
    "plt.xlabel('Number of Clusters K')\n",
    "plt.ylabel('SS')\n",
    "plt.xticks(K)\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 435,
   "id": "c62e2fd5-7ef2-48ed-b506-9aaa3111f32a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#scale the features\n",
    "X = df3[['remuneration', 'spending_score']]\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "#range for number of clusters\n",
    "K = range(2,11)\n",
    "\n",
    "#compute silhouette scores\n",
    "silhouette_scores = []\n",
    "for k in K:\n",
    "    kmeans = KMeans(n_clusters=k, init='k-means++', random_state=42)\n",
    "    labels = kmeans.fit_predict(X_scaled)\n",
    "    score = silhouette_score(X_scaled, labels)\n",
    "    silhouette_scores.append(score)\n",
    "\n",
    "#plot the silhouette score\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(K, silhouette_scores, 'bo-', markersize=8)\n",
    "plt.title('Silhouette Method')\n",
    "plt.xlabel('Number of Clusters')\n",
    "plt.ylabel('Silhouette Score')\n",
    "plt.xticks(list(K))\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4fe67e15-6dd3-4019-8459-4909f387cf07",
   "metadata": {},
   "source": [
    "How I determine the number of clusters\n",
    "\n",
    "At first glance, from the histogram graphs, I detected the best number of clusters was either 5 or 6.\n",
    "The graphs of the elbow method shows that adding to 5 or 6 don't improve the compactness. While the silhouette method tell us how well data points fit into each cluster and it still confirm that the best score is either 5 or 6 clusters. The elbow method and the silhoutte method confirm and established through two useful methods what was jsut an intuition at first sight.\n",
    "\n",
    "Anyway I think that the final decision has to be done in accordance with the purpose of the stakeholder. Maybe they prefer to have fewer cluster and for semplicity purpose, or maybe more separated clusters to isolate outliers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 437,
   "id": "88960cdb-3995-431f-9116-aa8592e0d0cb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Silhouette Score for k=5: 0.582\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 638.486x500 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#scale data\n",
    "x = df3[['remuneration', 'spending_score']]\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(x)\n",
    "\n",
    "#evaluate k=5\n",
    "kmeans = KMeans(n_clusters=5, \n",
    "                init='k-means++', \n",
    "                random_state=42)\n",
    "labels = kmeans.fit_predict(X_scaled)\n",
    "\n",
    "#cluster label k=5\n",
    "df3['cluster'] = labels\n",
    "x_plot_5 = x.copy()\n",
    "x_plot_5['K-Means Predicted'] = labels\n",
    "\n",
    "#compute the silhouette score\n",
    "sil_score = silhouette_score(X_scaled, labels)\n",
    "print(f\"Silhouette Score for k=5: {sil_score:.3f}\")\n",
    "\n",
    "#plot a pairplot\n",
    "sns.pairplot(x_plot_5, \n",
    "             hue='K-Means Predicted', \n",
    "             diag_kind='kde', \n",
    "             palette='Set1')\n",
    "\n",
    "#pairplot labels\n",
    "plt.suptitle(\"K-Means Clustering with k=5\",y=1.02)\n",
    "plt.show()"
   ]
  },
