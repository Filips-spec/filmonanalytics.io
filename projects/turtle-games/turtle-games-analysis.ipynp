   "source": [
    "#map polarity from [-1, 1] to [0, 100]\n",
    "df4_copy['summary_csat_score'] = ((df4_copy['summary_polarity'] + 1) / 2) * 100\n",
    "df4_copy['review_csat_score'] = ((df4_copy['review_polarity'] + 1) / 2) * 100\n",
    "\n",
    "# Calculate average CSAT\n",
    "average_summary_csat = df4_copy['summary_csat_score'].mean()\n",
    "average_review_csat = df4_copy['review_csat_score'].mean()\n",
    "\n",
    "print(f\"Average Customer Satisfaction Score (Summary): {average_summary_csat:.2f}%\")\n",
    "print(f\"Average Customer Satisfaction Score (Review): {average_review_csat:.2f}%\")\n"
   ]
