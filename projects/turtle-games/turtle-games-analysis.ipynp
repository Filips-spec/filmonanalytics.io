    "plt.subplot(1, 2, 1)\n",
    "df4_copy['summary_polarity'].hist(bins=15, color='skyblue', edgecolor='black')\n",
    "plt.title('Summary Polarity Distribution')\n",
    "plt.xlabel('Polarity')\n",
    "plt.ylabel('Frequency')\n",
    "\n",
