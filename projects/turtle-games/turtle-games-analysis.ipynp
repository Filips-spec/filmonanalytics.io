   "source": [
    "#print parameter and coefficients\n",
    "X_sm_age = sm.add_constant(X_age)\n",
    "model_age = sm.OLS(y, X_sm_age).fit()\n",
    "\n",
    "print(\"Age model parameters:\")\n",
    "print(model_age.params)\n",
    "print(\"\\nAge model standard errors:\")\n",
    "print(model_age.bse)\n"
   ]
  },
