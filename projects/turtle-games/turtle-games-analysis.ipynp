   "source": [
    "#plot and add regression line\n",
    "plt.scatter(X_train_age, y_train, color='red', alpha=0.6)\n",
    "plt.plot(X_train_age, y_pred_train_age, color='green', label='Regression Line')\n",
    "plt.title(\"Loyalty Points vs Age (Training Set)\")\n",
    "plt.xlabel(\"Age\")\n",
    "plt.ylabel(\"Loyalty Points\")\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
