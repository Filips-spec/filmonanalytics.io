   "source": [
    "#import libraries\n",
    "from nltk.probability import FreqDist\n",
    "from nltk.corpus import stopwords\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#create token lists from both columns\n",
    "all_tokens = []\n",
    "for tokens_list in df4_copy['summary'].dropna():\n",
    "    all_tokens.extend(tokens_list)\n",
    "\n",
    "for tokens_list in df4_copy['review'].dropna():\n",
    "    all_tokens.extend(tokens_list)\n",
    "\n",
    "#remove stopwords and non-alpha tokens\n",
    "stop_words = set(stopwords.words('english'))\n",
    "filtered_tokens = [word.lower() for word in all_tokens if word.isalpha() and word.lower() not in stop_words]\n",
    "\n",
    "#create frequency distribution\n",
    "fdist = FreqDist(filtered_tokens)\n",
    "\n",
    "#identify the 15 most common words\n",
    "print(fdist.most_common(15))\n",
    "\n",
    "#plot the frequency distribution\n",
    "plt.figure(figsize=(12,6))\n",
    "fdist.plot(15, title=\"Top 15 Most Frequent Words\")\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 464,
   "id": "f483a7e8-d6b5-43e2-b824-6d5fbbe243e3",
   "metadata": {},
   "outputs": [],
   "source": [
    "#convert token list into text strings\n",
    "df4_copy['summary_text'] = df4_copy['summary'].apply(lambda x: ' '.join(x) if isinstance(x, list) else '')\n",
    "df4_copy['review_text'] = df4_copy['review'].apply(lambda x: ' '.join(x) if isinstance(x, list) else '')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 465,
   "id": "c9a2b46d-33e1-4138-9b80-f2286f8acc2b",
   "metadata": {},
   "outputs": [],
   "source": [
    "from textblob import TextBlob\n",
    "\n",
    "#define a polarity function\n",
    "def get_polarity(text):\n",
    "    return TextBlob(text).sentiment.polarity\n",
    "\n",
    "#apply the def to the joined text\n",
    "df4_copy['summary_polarity'] = df4_copy['summary_text'].apply(get_polarity)\n",
    "df4_copy['review_polarity'] = df4_copy['review_text'].apply(get_polarity)\n"
   ]
  },
