   "source": [
    "#parameters for remuneration parameters\n",
    "X_sm_rem = sm.add_constant(X_rem)\n",
    "model_rem = sm.OLS(y, X_sm_rem).fit()\n",
    "\n",
    "print(\"Remuneration model parameters:\")\n",
    "print(model_rem.params)\n",
    "print(\"\\nRemuneration model standard errors:\")\n",
    "print(model_rem.bse)"
   ]
  },
