   "source": [
    "#plot scatter and add a regression line\n",
    "plt.scatter(X_train_rem, y_train, color='red', alpha=0.6)\n",
    "plt.plot(X_train_rem, y_pred_train_rem, color='green', label='Regression Line')\n",
    "plt.title(\"Loyalty Points vs Remuneration (Training Set)\")\n",
    "plt.xlabel(\"Remuneration\")\n",
    "plt.ylabel(\"Loyalty Points\")\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
