    "df4_copy['review_polarity'].hist(bins=15, color='lightgreen', edgecolor='black')\n",
    "plt.title('Review Polarity Distribution')\n",
    "plt.xlabel('Polarity')\n",
    "plt.ylabel('Frequency')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
