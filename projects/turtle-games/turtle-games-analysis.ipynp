    "df2.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 418,
   "id": "fff3a6d5-a2e4-43bd-9a95-7d0809d7e586",
   "metadata": {},
   "outputs": [],
   "source": [
    "#specify target variable (y)\n",
    "x = df2.drop('loyalty_points', axis=1)\n",
    "y = df2['loyalty_points']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 419,
   "id": "652d4db8-aad5-4af3-8fda-aec8663d4847",
   "metadata": {},
   "outputs": [],
   "source": [
    "#fit the tree\n",
    "#create a testing set\n",
    "x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.7, random_state=42)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 420,
   "id": "ba946593-6798-46c8-9045-b044b90d7f13",
   "metadata": {},
   "outputs": [],
   "source": [
    "#import libraries \n",
    "from sklearn.tree import DecisionTreeRegressor\n",
    "\n",
    "#create the regression \n",
    "regressor = DecisionTreeRegressor(random_state=42)"
   ]
