   ],
   "source": [
    "#fit the model of training data\n",
    "regressor.fit(x_train, y_train)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 422,
   "id": "8a2974a7-1ceb-4776-a983-11c893a6ad32",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train R² score: 1.0\n",
      "Test R² score: 0.9932478409108636\n"
     ]
    }
   ],
   "source": [
    "#print accuracy values\n",
    "from sklearn.metrics import mean_squared_error, r2_score\n",
    "\n",
    "#predict on training and testing sets using the decision tree regressor\n",
    "y_pred_train = regressor.predict(x_train)\n",
    "y_pred_test = regressor.predict(x_test)\n",
    "\n",
    "#now you can calculate R²\n",
    "from sklearn.metrics import mean_squared_error, r2_score\n",
    "\n",
    "print(\"Train R² score:\", r2_score(y_train, y_pred_train))\n",
    "print(\"Test R² score:\", r2_score(y_test, y_pred_test))\n"
   ]
  },
  {
